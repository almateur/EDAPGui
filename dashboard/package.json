{
  "name": "edap-dashboard",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + Vue.js Dashboard for Elite Dangerous Autopilot",
  "main": "dist/server.js",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "server": "node dist/server.js",
    "start": "npm run build && npm run server",
    "test": "npm run build:server && node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "vue": "3.5.45",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.19.43",
    "@types/ws": "8.5.10",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
