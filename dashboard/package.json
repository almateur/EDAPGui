{
  "name": "edap-dashboard",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + Vue.js Dashboard for Elite Dangerous Autopilot",
  "main": "dist/server.js",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "server": "node dist/server.js",
    "start": "npm run build && npm run server"
  },
  "dependencies": {
    "express": "^4.19.2",
    "vue": "^3.4.27",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vue-tsc": "^2.0.19"
  }
}
